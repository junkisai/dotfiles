# Ghostty の配色とフォント設定の控え。
# 本体は Brewfile に入れていないので、使うときは配布元から入れて
# このファイルを ~/.config/ghostty/config に置く。
# 全オプションは `ghostty +show-config --default --docs` か https://ghostty.org/docs/config

theme = tokyonight

font-family = "BIZ UDGothic"
font-style = Bold
font-size = 14
font-thicken = true

background-opacity = 0.85
background-blur-radius = 20

unfocused-split-opacity = 0.7

cursor-opacity = 0.8
cursor-color = ffffff

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = always

macos-titlebar-style = tabs
macos-option-as-alt = true

browser = false
